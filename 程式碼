function generateQuiz(weakNode, taskName) {
  const cache=CacheService.getScriptCache(),cacheKey='BankData_V3';
  let bankRows=null;const cached=cache.get(cacheKey);
  if(cached){try{bankRows=JSON.parse(cached);}catch(e){bankRows=null;}}
  if(!bankRows){
    const bank=SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Bank');
    if(!bank||bank.getLastRow()<2) return [];
    bankRows=bank.getDataRange().getValues().slice(1).filter(r=>r[0]);
    try{cache.put(cacheKey,JSON.stringify(bankRows),600);}catch(e){}
  }
  let subject='';
  if(taskName){const tSheet=SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Tasks');
    if(tSheet&&tSheet.getLastRow()>1){const tRows=tSheet.getDataRange().getValues();
      for(let i=1;i<tRows.length;i++){if(String(tRows[i][0])===String(taskName)){subject=String(tRows[i][2]||'');break;}}}}
  const qCount=parseInt(getConfig().QuizCount,10)||10;
  const isValid=weakNode&&_isValid(weakNode);
  let pool=bankRows.filter(r=>{
    const nd=String(r[1]||'');
    const nodeOk=isValid?(nd.includes(weakNode)||weakNode.includes(nd)):(nd.includes('通用練習')||nd.includes('基礎練習'));
    return nodeOk&&(!subject||String(r[8]||'')===subject)&&r[2];
  });
  if(pool.length<qCount) pool=pool.concat(bankRows.filter(r=>r[2]&&(!subject||String(r[8]||'')===subject)&&!pool.includes(r)));
  return pool.sort(()=>Math.random()-.5).slice(0,qCount).map(r=>({
    id:r[0],node:String(r[1]||''),text:String(r[2]||''),type:String(r[3]||'single'),
    options:_tryJSON(r[4],[]),answer:String(r[5]||''),difficulty:String(r[6]||'easy'),
    grade:String(r[7]||''),subject:String(r[8]||''),hint:String(r[9]||'')
  }));
}

