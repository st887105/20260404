  const nm={};
  results.forEach(r=>(r.details||[]).forEach(d=>{
    if(!d.correct){const nd=d.node||'未知';if(!nm[nd])nm[nd]={count:0,wrongTexts:new Set()};nm[nd].count++;if(d.text)nm[nd].wrongTexts.add(d.text);}
  }));
  if(!Object.keys(nm).length)return[];
  const bank=SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Bank');
  const bankRows=(bank&&bank.getLastRow()>=2)?bank.getDataRange().getValues().slice(1):[];
  const top3=Object.entries(nm).sort((a,b)=>b[1].count-a[1].count).slice(0,3);
  return top3.map(([node,data])=>{
    const pool=bankRows.filter(r=>{
      const nd=String(r[1]||'');
      return(nd.includes(node)||node.includes(nd))&&(!subject||String(r[8]||'')===subject)&&(!grade||String(r[7]||'')===grade)&&!data.wrongTexts.has(String(r[2]||''))&&r[2];
    });
    const questions=pool.sort(()=>Math.random()-.5).slice(0,3).map(r=>({
      text:String(r[2]||''),type:String(r[3]||'single'),options:_tryJSON(r[4],[]),answer:String(r[5]||''),
      difficulty:String(r[6]||''),hint:String(r[9]||'').replace(/^\[Level [ABCD]\]\s*/,''),
      level:(String(r[9]||'').match(/Level ([ABCD])/)||[])[1]||'D'
    }));
    if(questions.length<2){
      try{
        const prompt=_buildPrompt(subject,grade,[node],3,null,'ai')+'\n\n注意：請出與以下題目「不同」的類似題：\n'+[...data.wrongTexts].slice(0,3).join('\n');
        const rawText=_callGemini(prompt,2048,true);
        const aiQs=_parseAI(rawText).filter(q=>q&&q.text&&Array.isArray(q.options)&&q.options.length>=2).slice(0,3-questions.length)
          .map(q=>({text:String(q.text||''),type:q.type||'single',options:q.options||[],answer:_normAnswer(q.answer),difficulty:q.difficulty||'easy',hint:q.hint||'',level:q.level||'D'}));
        questions.push(...aiQs);
      }catch(e){Logger.log('[getPracticeQuestionsForErrors] AI 補題失敗：'+e.message);}
    }
    return{node,errorCount:data.count,questions};
  }).filter(i=>i.questions.length>0);
}

