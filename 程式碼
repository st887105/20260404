// ★ 診斷測試函式（在 GAS 編輯器直接執行）
// ============================================================
function testGeminiAPI() {
  const cfg    = getConfig();
  const apiKey = String(cfg.GeminiAPIKey || '').trim();
  const model  = String(cfg.GeminiModel  || 'gemini-2.5-flash').trim();
  if (!apiKey || apiKey.includes('請在此')) {
    SpreadsheetApp.getUi().alert('❌ 尚未設定 GeminiAPIKey！\n請在 Config 分頁填入 API 金鑰。');
    return;
  }
  const MODELS_TO_TRY = [model, 'gemini-2.5-flash', 'gemini-2.0-flash-lite', 'gemini-2.0-flash', 'gemini-1.5-flash'];
  const unique = [];
  MODELS_TO_TRY.forEach(m => { if (!unique.includes(m)) unique.push(m); });
  let report = '=== Gemini API 診斷報告 ===\n';
  let firstWorkingModel = null;
  for (let i = 0; i < unique.length; i++) {
    const m = unique[i];
    const url = 'https://generativelanguage.googleapis.com/v1beta/models/' + m + ':generateContent?key=' + apiKey;
    try {
      const resp = UrlFetchApp.fetch(url, {
        method:'post', contentType:'application/json',
        payload:JSON.stringify({contents:[{parts:[{text:'請回答「OK」'}]}],generationConfig:{maxOutputTokens:10}}),
        muteHttpExceptions:true, deadline:20
      });
      const data = JSON.parse(resp.getContentText());
      if (!data.error) {
        report += '✅ ' + m + '：正常可用\n';
        if (!firstWorkingModel) firstWorkingModel = m;
      } else {
        report += '❌ ' + m + '：' + data.error.code + ' ' + String(data.error.message||'').substring(0,60) + '\n';
      }
    } catch(e) {
      report += '❌ ' + m + '：連線錯誤 - ' + String(e.message||e).substring(0,50) + '\n';
    }
    if (i < unique.length - 1) Utilities.sleep(4000);
  }
  if (firstWorkingModel) {
    const cfgSheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Config');
    const rows = cfgSheet.getDataRange().getValues();
    for (let i = 1; i < rows.length; i++) {
      if (String(rows[i][0]) === 'GeminiModel') {
        cfgSheet.getRange(i+1,2).setValue(firstWorkingModel);
        report += '\n→ 已自動更新 Config.GeminiModel = ' + firstWorkingModel;
        break;
      }
    }
  }
  Logger.log(report);
  SpreadsheetApp.getUi().alert(
    report + '\n\n' +
    (firstWorkingModel ? '✅ 可用！請回到網站點「重新出題」。'
     : '⚠️ 所有模型都不可用。\n如果看到 429，請等 60 秒後再試。\n如果看到 403，請確認 API 金鑰有效。')
  );
}

// ============================================================
// Gemini API 呼叫（多模型降級版）
// ============================================================
function _callGemini(prompt, maxTokens, jsonMode) {
  const cfg    = getConfig();
  const apiKey = String(cfg.GeminiAPIKey || '').trim();
  const preferred = String(cfg.GeminiModel || 'gemini-2.5-flash').trim();
  if (!apiKey || apiKey.includes('請在此')) throw new Error('請先在 Config 試算表設定 GeminiAPIKey！');

  const FALLBACK_MODELS = ['gemini-2.5-flash','gemini-2.0-flash-lite','gemini-2.0-flash','gemini-1.5-flash'];
  const modelsToTry = [preferred, ...FALLBACK_MODELS.filter(m => m !== preferred)];
  const genConfig = { temperature:0.65, maxOutputTokens:maxTokens||2048 };
  if (jsonMode) genConfig.responseMimeType = 'application/json';
  const body = JSON.stringify({ contents:[{parts:[{text:prompt}]}], generationConfig:genConfig });

  let lastError = '尚未嘗試任何模型';
  for (const model of modelsToTry) {
    const endpoints = [
      'https://generativelanguage.googleapis.com/v1beta/models/'+model+':generateContent?key='+apiKey,
      'https://generativelanguage.googleapis.com/v1/models/'+model+':generateContent?key='+apiKey
    ];
    for (const url of endpoints) {
      for (let retry = 0; retry < 2; retry++) {
        let resp, result;
        try {
          resp = UrlFetchApp.fetch(url, {method:'post',contentType:'application/json',payload:body,muteHttpExceptions:true,deadline:30});
        } catch(networkErr) {
          lastError = '網路錯誤：'+String(networkErr.message||networkErr).substring(0,60);
          if (retry < 1) Utilities.sleep(2000);
          continue;
        }
        let rawText = '';
        try { rawText = resp.getContentText(); } catch(e) { rawText = ''; }
        if (!rawText || rawText.trim().startsWith('<')) { lastError = model+'：回傳非 JSON'; break; }
        try { result = JSON.parse(rawText); } catch(e) { lastError = model+'：JSON 解析失敗'; break; }
        if (!result.error) {
          if (model !== preferred) Logger.log('[降級] ' + preferred + ' → ' + model);
          try { return result.candidates[0].content.parts[0].text; } catch(e) { lastError = model+'：candidates 解析失敗'; break; }
        }
        const code = Number(result.error.code||0);
        const msg  = String(result.error.message||'');
        lastError  = model+' '+code+' '+msg.substring(0,80);
        Logger.log('[ERR] ' + lastError);
        if (code===429||msg.includes('quota')||msg.includes('RESOURCE_EXHAUSTED')) {
          Utilities.sleep((retry===0?20:50)*1000); continue;
        }
        if (code===404||msg.includes('not found')||msg.includes('not supported')) break;
        if (code===403||msg.includes('API key')) throw new Error('API 金鑰無效（403）。請至 https://aistudio.google.com 確認。');
        throw new Error('Gemini '+code+'：'+msg.substring(0,120));
      }
    }
  }
  throw new Error('所有 Gemini 模型均無法使用。最後錯誤：'+lastError+'\n如見 429：等 60 秒後到「題庫管理」點「重新出題」繼續。\n如見 404：到 GAS 執行 testGeminiAPI() 確認。');
}

