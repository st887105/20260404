function scanFolder(folderId) {
  if (!folderId) throw new Error('請提供資料夾 ID');
  try {
    const folder=DriveApp.getFolderById(folderId),files=folder.getFilesByType(MimeType.PDF),result=[];
    while(files.hasNext()){const f=files.next();result.push({id:f.getId(),name:f.getName(),size:f.getSize()});}
    return result;
  } catch(e) { throw new Error('無法存取資料夾：'+e.message); }
}

function extractPdfText(fileId) {
  const cache=CacheService.getScriptCache(),key='PDF_'+fileId,hit=cache.get(key);if(hit)return hit;
  try {
    const blob=DriveApp.getFileById(fileId).getBlob();
    const docId=Drive.Files.insert({title:'tmp_ocr_'+fileId,mimeType:MimeType.GOOGLE_DOCS},blob).id;
    const text=DocumentApp.openById(docId).getBody().getText().substring(0,8000);
    Drive.Files.remove(docId);
    try{cache.put(key,text,3600);}catch(e){}
    return text;
  } catch(e) { Logger.log('PDF 擷取失敗：'+e.message); return ''; }
}

