/**
 * 取得指定任務的學生清單
 * ★ FIXED v8.9q: String(r[0]) === String(taskName)
 *   避免 Google Sheets 將數字型任務名稱（如"101"）自動轉為 number 101
 *   導致嚴格比較 === 永遠失敗，造成「此任務無學生資料」的問題。
 *
 * ★ FIXED v8.9p: 支援「4年 1班 3號 陳勝文 2」混合格式自動拆分
 */
function getStudents(taskName) {
  if (!taskName) throw new Error('請提供任務名稱');
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Students');
  if (!sheet||sheet.getLastRow()<2) return [];

  return sheet.getDataRange().getValues().slice(1)
    // ★ 關鍵修正：用 String() 轉換後再比較，避免 number vs string 型別不符
    .filter(r => String(r[0]) === String(taskName) && String(r[1]||'').trim())
    .map(r => {
      let number = String(r[1]).trim();
      let name   = String(r[2]||'').trim();

      // 若 name 欄空白，嘗試從 number 欄提取中文姓名
      // 例：「4年 1班 3號 陳勝文 2」→ name="陳勝文", number="4年 1班 3號"
      if (!name || name==='null' || name==='undefined') {
        const m = number.match(/號\s*([\u4e00-\u9fa5]{2,4})(?:\s+\d+)?$/);
        if (m) {
          name   = m[1];
          number = number.replace(/\s+[\u4e00-\u9fa5]{2,4}(?:\s+\d+)?$/,'').trim();
        }
      }

      return {
        taskName:  String(r[0]),
        number:    number,
        name:      name,
        weakNodes: _tryJSON(r[3],[]).filter(_isValid)
      };
    });
}

