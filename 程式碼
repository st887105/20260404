function getQuestionErrorRates(taskName) {
  const em={};
  getTaskResults(taskName).forEach(r=>(r.details||[]).forEach(d=>{
    const k=d.node||d.text||'未知';if(!em[k])em[k]={node:d.node||'',total:0,wrong:0};
    em[k].total++;if(!d.correct)em[k].wrong++;
  }));
  return Object.entries(em).map(([k,v])=>({question:k,node:v.node,total:v.total,wrong:v.wrong,errorRate:v.total>0?Math.round(v.wrong/v.total*100):0})).sort((a,b)=>b.errorRate-a.errorRate);
}

function analyzeClassWeakNodes(taskName) {
  const nm={};
  getTaskResults(taskName).forEach(r=>(r.details||[]).forEach(d=>{
    const nd=d.node||'未知';
    if(!nm[nd])nm[nd]={total:0,wrong:0,byLevel:{A:0,B:0,C:0,D:0,AW:0,BW:0,CW:0,DW:0}};
    nm[nd].total++;if(!d.correct)nm[nd].wrong++;
    const lv=d.level||(d.hint&&d.hint.match(/Level ([ABCD])/)?.[1])||'';
    if(lv&&nm[nd].byLevel[lv]!==undefined){nm[nd].byLevel[lv]++;if(!d.correct)nm[nd].byLevel[lv+'W']++;}
  }));
  return Object.entries(nm).map(([nd,v])=>({
    node:nd,total:v.total,wrong:v.wrong,errorRate:v.total>0?Math.round(v.wrong/v.total*100):0,
    levelStats:['A','B','C','D'].map(lv=>({level:lv,total:v.byLevel[lv]||0,wrong:v.byLevel[lv+'W']||0,
      errorRate:(v.byLevel[lv]||0)>0?Math.round((v.byLevel[lv+'W']||0)/v.byLevel[lv]*100):null})).filter(l=>l.total>0)
  })).sort((a,b)=>b.errorRate-a.errorRate).slice(0,10);
}

