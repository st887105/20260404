function verifyAdmin(pwd) {
  const cfg = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Config');
  if (!cfg) return false;
  return cfg.getDataRange().getValues().slice(1).some(r => String(r[0])==='AdminPassword' && String(r[1])===String(pwd));
}

function getConfig() {
  const cfg = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Config');
  if (!cfg) return {};
  const out = {};
  cfg.getDataRange().getValues().forEach(r => { if(r[0]) out[String(r[0])]=r[1]; });
  return out;
}

function _updateConfigValue(sheet, key, value) {
  const rows = sheet.getDataRange().getValues();
  for (let i=1;i<rows.length;i++) { if(String(rows[i][0])===String(key)){ sheet.getRange(i+1,2).setValue(value); return; } }
  sheet.appendRow([key,value]);
}

function getQuizSettings()     { return { quizCount:parseInt(getConfig().QuizCount,10)||10 }; }
function updateQuizSettings(n) { const v=parseInt(n,10); if(isNaN(v)||v<1) throw new Error('請輸入有效數字'); _updateConfigValue(SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Config'),'QuizCount',v); return '✅ 題數已更新為'+v+'題'; }
function updateFolderId(id)    { const s=String(id||'').split('?')[0].trim(); _updateConfigValue(SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Config'),'PdfFolderId',s); return '✅ 資料夾 ID 已儲存'; }
function getFolderId()         { const id=String(getConfig().PdfFolderId||'').split('?')[0].trim(); return (id&&!id.startsWith('（')&&id.length>5)?id:''; }
function getSystemPrompts()    { const c=getConfig(); return {mathPrompt:String(c.MathPrompt||''),chinesePrompt:String(c.ChinesePrompt||''),mathWorksheetPrompt:String(c.MathWorksheetPrompt||''),chineseWorksheetPrompt:String(c.ChineseWorksheetPrompt||'')}; }
function updateSystemPrompts(mathP,chineseP,mathWS,chineseWS,pwd) {
  if (!verifyAdmin(pwd)) throw new Error('密碼錯誤！');
  const c=SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Config');
  if(mathP!==undefined)    _updateConfigValue(c,'MathPrompt',mathP||'');
  if(chineseP!==undefined) _updateConfigValue(c,'ChinesePrompt',chineseP||'');
  if(mathWS!==undefined)   _updateConfigValue(c,'MathWorksheetPrompt',mathWS||'');
  if(chineseWS!==undefined)_updateConfigValue(c,'ChineseWorksheetPrompt',chineseWS||'');
  return '✅ 提示詞已更新！';
}
function getGeminiSettings()   { const c=getConfig(); return {model:String(c.GeminiModel||'gemini-2.5-flash'),isPaid:String(c.IsPaidAccount||'false').toLowerCase()==='true'}; }
function updateGeminiSettings(model,isPaid,pwd) {
  if (!verifyAdmin(pwd)) throw new Error('密碼錯誤！');
  const c=SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Config');
  if(model!==undefined) _updateConfigValue(c,'GeminiModel',String(model||'gemini-2.5-flash').trim());
