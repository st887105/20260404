}

function _parseAI(rawText) {
  const clean = String(rawText||'').replace(/```json/gi,'').replace(/```/g,'').trim();
  try { const r=JSON.parse(clean); if(Array.isArray(r)&&r.length>0)return r; } catch(e) {}
  const s=clean.indexOf('['),end=clean.lastIndexOf(']');
  if (s>=0&&end>s) { try { const r=JSON.parse(clean.substring(s,end+1)); if(Array.isArray(r)&&r.length>0)return r; } catch(e) {} }
  const objs=[],re=/\{[^{}]*(?:"[^"]*"[^{}]*)*\}/g;let match;
  while((match=re.exec(clean))!==null){try{const o=JSON.parse(match[0]);if(o&&o.text&&o.options)objs.push(o);}catch(e){}}
  if (objs.length>0) return objs;
  throw new Error('AI 回傳格式無法解析：'+clean.substring(0,200));
}

// ============================================================
// 6. 節點有效性
// ============================================================
function _isValid(node) {
  const s = String(node||'').trim();
  if (!s) return false;
  if (['-','未診斷','未精熟','未作答','精熟','不通過','0'].includes(s)) return false;
  if (/^\d+(\.\d+)?$/.test(s)) return false;
  if (s.length<3) return false;
  return true;
}

// ============================================================
// 7. 批次出題引擎
// ============================================================
function _doGenerateBatch(nodesArray, grade, subject, batchIndex, pdfText, mode) {
  const BATCH_SIZE=5, QCOUNT=3;
  const safeArray  = nodesArray||[];
  const validNodes = safeArray.map(n=>String(n||'').trim()).filter(_isValid);
  const hasInvalid = safeArray.some(n=>n&&!_isValid(String(n||'').trim()));
  const nodeBatches=[];
  for (let i=0;i<validNodes.length;i+=BATCH_SIZE) nodeBatches.push({nodes:validNodes.slice(i,i+BATCH_SIZE),isGeneral:false});
  if (validNodes.length===0||hasInvalid) nodeBatches.push({nodes:['通用基礎練習'],isGeneral:true});
  const total=nodeBatches.length;
  if (batchIndex>=total) {
    try{CacheService.getScriptCache().remove('BankData_V3');}catch(e){}
    return {done:true,current:total,total,message:'✅ 全部完成！共 '+total+' 批次。'};
  }
  const batch=nodeBatches[batchIndex];
  let prompt,maxTok;
  if (batch.isGeneral) { prompt=_buildGeneralPrompt(subject,grade,10); maxTok=3072; }
  else { prompt=_buildPrompt(subject,grade,batch.nodes,QCOUNT,pdfText,mode||'ai'); maxTok=Math.min(8192,batch.nodes.length*QCOUNT*500+512); }
  const rawText=_callGemini(prompt,maxTok,true);
  let questions=[];
  try {
    questions=_parseAI(rawText);
    questions=(questions||[]).filter(q=>q&&q.text&&Array.isArray(q.options)&&q.options.length>=2);
  } catch(parseErr) { Logger.log('[解析失敗] batch='+batchIndex+' error='+parseErr.message); questions=[]; }
  const bank=SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Bank');
  if (!bank) throw new Error('Bank 分頁不存在，請先初始化資料庫');
  const ts=Date.now().toString().slice(-6);
  const newRows=questions.map((q,idx)=>{
    const lv=q.level||'D';
    const nd=batch.isGeneral?('通用練習('+subject+grade+')'):(q.node||batch.nodes[0]);
    return ['AI-'+subject+'-'+ts+'-'+batchIndex+'-'+idx,nd,String(q.text||''),q.type||'single',JSON.stringify(q.options||[]),_normAnswer(q.answer),q.difficulty||'easy',grade,subject,'[Level '+lv+'] '+(q.hint||'')];
  });
  if (newRows.length>0) {
    const lastRow=bank.getLastRow()||1;
    bank.getRange(lastRow+1,1,newRows.length,10).setValues(newRows);
    bank.getRange(lastRow+1,6,newRows.length,1).setNumberFormat('@STRING@');
  }
  const isLast=(batchIndex+1>=total);
  if (isLast) try{CacheService.getScriptCache().remove('BankData_V3');}catch(e){}
  const nodeLabel=batch.isGeneral?'通用練習':batch.nodes.join('、');
  return {done:isLast,current:batchIndex+1,total,addedThisBatch:newRows.length,message:'['+subject+'] 第 '+(batchIndex+1)+'/'+total+' 批完成（'+nodeLabel+'）— 新增 '+newRows.length+' 題'};
}

function generateBatch(nodesArray,grade,subject,batchIndex){return _doGenerateBatch(nodesArray,grade,subject||'數學',batchIndex,null,'ai');}
function generateBatchFromFolder(folderId,nodesArray,grade,subject,batchIndex,mode){
  let pdfText='';
  if(folderId){try{const files=scanFolder(folderId),texts=[];for(let i=0;i<Math.min(files.length,3);i++){const t=extractPdfText(files[i].id);if(t)texts.push(t);if(texts.join('').length>6000)break;}pdfText=texts.join('\n\n').substring(0,8000);}catch(e){pdfText='';}}
  return _doGenerateBatch(nodesArray,grade,subject||'數學',batchIndex,pdfText,mode||'mixed');
}
function regenerateBatchForTask(taskName,batchIndex,mode,folderId){
  const task=getTasks().find(t=>t.taskName===taskName);
  if(!task) throw new Error('找不到任務：'+taskName);
  const validNodes=(task.weakNodes||[]).filter(_isValid);
  let pdfText='';
  if((mode==='pdf'||mode==='mixed')&&folderId){try{const files=scanFolder(folderId),texts=[];for(let i=0;i<Math.min(files.length,3);i++){const t=extractPdfText(files[i].id);if(t)texts.push(t);}pdfText=texts.join('\n\n').substring(0,8000);}catch(e){}}
  return _doGenerateBatch(validNodes.length>0?validNodes:['通用基礎練習'],task.grade,task.subject,batchIndex,pdfText,mode||'ai');
}
function _normAnswer(str){if(str===null||str===undefined)return '';return String(str).trim().replace(/\s+/g,'').toUpperCase().charAt(0)||'A';}

