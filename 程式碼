// 10. 題庫快取與清理
// ============================================================
function clearBankCache(){try{CacheService.getScriptCache().remove('BankData_V3');}catch(e){}return'✅ 題庫快取已清除';}
function clearNodesFromBank(nodesArray,grade,subject){
  const nodes=(nodesArray||[]).filter(_isValid);if(!nodes.length)throw new Error('請提供有效節點清單');
  const bank=SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Bank');
  if(!bank||bank.getLastRow()<2)return'題庫為空，無需清除';
  const rows=bank.getDataRange().getValues();let deleted=0;
  for(let i=rows.length-1;i>=1;i--){
    const nd=String(rows[i][1]||''),g=String(rows[i][7]||''),s=String(rows[i][8]||'');
    if(nodes.some(n=>nd.includes(n)||n.includes(nd))&&(!grade||g===grade)&&(!subject||s===subject)){bank.deleteRow(i+1);deleted++;}
  }
  clearBankCache();return'✅ 已清除 '+deleted+' 題';
}
function cleanResultsSheet(){
  const sheet=SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Results');if(!sheet)return'找不到 Results 分頁';
  const rows=sheet.getDataRange().getValues();let deleted=0;
  for(let i=rows.length-1;i>=1;i--){if(!rows[i].some(c=>c!==null&&c!==undefined&&String(c).trim())){sheet.deleteRow(i+1);deleted++;}}
  return'已清除 '+deleted+' 列空白資料';
}

