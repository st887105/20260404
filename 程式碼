function uploadTaskData(taskName, grade, subject, studentData, uniqueNodes) {
  if (!taskName||!grade||!subject) throw new Error('任務名稱、年級、科目為必填');
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const stdData = (studentData||[]).filter(s => s && String(s.number||'').trim());
  const uNodes  = (uniqueNodes||[]).filter(_isValid);

  const tasksSheet = ss.getSheetByName('Tasks');
  if (!tasksSheet) throw new Error('請先執行「初始化資料庫」');
  const taskRows = tasksSheet.getDataRange().getValues();
  let taskRowIdx = -1;
  // ★ FIXED v8.9q: String() 轉換比較，避免 Sheets 將數字型名稱存為 number
  for (let i=1;i<taskRows.length;i++) {
    if (String(taskRows[i][0]) === String(taskName)) { taskRowIdx=i+1; break; }
  }
  const taskRow = [taskName,grade,subject,new Date().toLocaleString('zh-TW'),stdData.length,JSON.stringify(uNodes)];
  if (taskRowIdx>0) tasksSheet.getRange(taskRowIdx,1,1,6).setValues([taskRow]);
  else              tasksSheet.appendRow(taskRow);

  const studSheet = ss.getSheetByName('Students');
  if (studSheet) {
    if (studSheet.getLastRow()>1) {
      const sRows = studSheet.getDataRange().getValues();
      // ★ FIXED v8.9q: String() 比較
      for (let i=sRows.length-1;i>=1;i--) {
        if (String(sRows[i][0])===String(taskName)) studSheet.deleteRow(i+1);
      }
    }
    if (stdData.length>0) {
      studSheet.getRange(studSheet.getLastRow()+1,1,stdData.length,4)
        .setValues(stdData.map(s=>[
          taskName,
          String(s.number||'').trim(),   // B欄：座號
          String(s.name  ||'').trim(),   // C欄：姓名
          JSON.stringify((s.weakNodes||[]).filter(_isValid))
        ]));
    }
  }

  const hist = ss.getSheetByName('History');
  if (hist) hist.appendRow([new Date().toLocaleString('zh-TW'),taskName,grade,subject,stdData.length,JSON.stringify(uNodes)]);

  _createTaskSheet(ss,taskName,grade,subject,stdData,uNodes);
  return {taskName,studentCount:stdData.length,nodes:uNodes};
}

function _createTaskSheet(ss, taskName, grade, subject, studentData, uniqueNodes) {
  try {
    const name    = taskName.substring(0,40);
    const existing= ss.getSheetByName(name);
    if (existing) ss.deleteSheet(existing);
    const sheet   = ss.insertSheet(name);
    SpreadsheetApp.flush();
    const stdData = studentData||[];
    const uNodes  = uniqueNodes||[];
    const rows = [];
    rows.push(['任務資訊','年級：'+grade,'科目：'+subject,'建立時間：'+new Date().toLocaleString('zh-TW')]);
    rows.push(['','','','']);
    rows.push(['座號','姓名','弱點節點','weakNodes(JSON)']);
    stdData.forEach(s=>rows.push([String(s.number||'').trim(),String(s.name||'').trim(),(s.weakNodes||[]).join('、'),JSON.stringify(s.weakNodes||[])]));
    sheet.getRange(1,1,rows.length,4).setValues(rows);
    const sumRow = rows.length+2;
    sheet.getRange(sumRow,1,1,2).setValues([['班級弱點節點匯總',uNodes.join('、')]]);
    sheet.getRange(1,1,1,4).setBackground('#1e88e5').setFontColor('#fff').setFontWeight('bold');
    sheet.getRange(3,1,1,4).setBackground('#e3f2fd').setFontWeight('bold');
    [120,80,400,200].forEach((w,i)=>sheet.setColumnWidth(i+1,w));
  } catch(e) { Logger.log('[TaskSheet 錯誤] '+e.message); }
}

function getTasks() {
